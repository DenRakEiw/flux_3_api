# Vorlage - kopieren nach .env und Keys eintragen

# BFL Flux 3 API (https://api.bfl.ai)
BFL_API_KEY=dein-key-hier

# Optional. Default ist https://api.bfl.ai . Nur ändern, wenn BFL einen
# anderen Host bekannt gibt.
# BFL_BASE_URL=https://api.bfl.ai

# Optional: host for the Flux3Image node. Default https://api.bfl.ai .
# BFL_IMAGE_BASE_URL=https://api.bfl.ai

# OpenRouter for the Flux 3 Openrouter Prompt node (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-...
